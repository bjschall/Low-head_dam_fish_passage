# Define cutoffs
blue_cutoffs <- tibble(
  Species = "Blue Sucker",
  temp_z = c(-1.1143079, -0.4287949,  0.2567181,  0.9422311),
  max_gage_z = c(0.48670059, 0.02470374, 1.62491628, 2.04819831),
  min_gage_z = c(-1.10318800, -0.65667708, -0.78314549, -0.82444130)
)

silver_cutoffs <- tibble(
  Species = "Silver Carp",
  temp_z = c(-0.4287949,  0.2567181,  0.9422311),
  max_gage_z = c(1.30745476, 3.70519258, 2.73216012),
  min_gage_z = c(-1.06963515, -1.07221614, -0.90703291)
)

cutoffs <- bind_rows(blue_cutoffs, silver_cutoffs) %>% tidyr::expand(cutoffs, length_z = c(-1, 0, 1))

#Create a 50 point gage_z variable to model over using the min and max observed value for each species and temp
sim <- cutoffs %>%
  mutate(gage_z = map2(min_gage_z, max_gage_z, ~ seq(.x, .y, length.out = 50))) %>%
  unnest(gage_z) %>% 
   select(-max_gage_z, -min_gage_z) #%>% 
  # mutate(Year = 2026,
  #        ShortID = "NEWFISH")


#posterior draws
draws_mod<-add_epred_draws(newdata = sim, 
                           gage_temp_int_length_mod, 
                           re_formula = ~(1 + length_z + gage_z*temp_z|Species), 
                           allow_new_levels=F) 

#summarize median and 80% CrI and rescale predictors to the measured level
gage_qi <- draws_mod %>% 
  group_by(Species, gage_z, temp_z, length_z) %>% 
  median_qi(.epred, .width=.8) %>% 
  group_by(Species) %>% 
  mutate(facet="Gage height (m)",
         gage_z_scaled = gage_z*sd(df.final$GH_m)+mean(df.final$GH_m), 
         temp_z_scaled = temp_z*sd(df.final$MeanTemp)+mean(df.final$MeanTemp),
