#Model comparison using LOO
loo_compare(
  loo(null_mod, moment_match = TRUE),
  loo(gage_mod, moment_match = TRUE),
  loo(temp_mod, moment_match = TRUE),
  loo(length_mod, moment_match = TRUE),
  loo(gage_length_mod, moment_match = TRUE),
  loo(gage_temp_mod, moment_match = TRUE, reloo=TRUE),
  loo(length_temp_mod, moment_match = TRUE),
  loo(global_mod, moment_match = TRUE)
)

#Top model 
#Positive slope parameters?
sum((as_draws_df(gage_temp_mod)$b_gage_z)>0)/10000
sum((as_draws_df(gage_temp_mod)$b_temp_z)>0)/10000

conditional_effects(gage_temp_mod)

####sample from posterior
#gage
sim_bsr_gage <- tibble(gage_z = c(seq(min(filter(df.final, Species == "Blue Sucker")$gage_z), max(filter(df.final, Species == "Blue Sucker")$gage_z), length.out = 99),0), 
                       temp_z = 0)

draws_bsr_gage<-add_epred_draws(newdata = sim_bsr_gage, 
                           gage_temp_mod, 
                           re_formula = NA, 
                           allow_new_levels=T) 

gage_bsr <- draws_bsr_gage %>% 
  group_by(gage_z) %>% 
  mean_qi(.epred) %>% 
  mutate(facet="Gage height (m)",
         variable_z_scaled = gage_z*sd(filter(df.final, Species == "Blue Sucker")$GH_m)+mean(filter(df.final, Species == "Blue Sucker")$GH_m))%>% 
  rename(variable_z = gage_z) %>% 
  select(-.width, -.point, -.interval); gage_bsr

#temperature
sim_bsr_temp <- tibble(gage_z = 0,
                       temp_z = c(seq(min(filter(df.final, Species == "Blue Sucker")$temp_z), max(filter(df.final, Species == "Blue Sucker")$temp_z), length.out = 99),0))


draws_bsr_temp<-add_epred_draws(newdata = sim_bsr_temp, 
                           gage_temp_mod, 
                           re_formula = NA, 
                           allow_new_levels=T) 

temp_bsr <- draws_bsr_temp %>% 
  filter(gage_z==0) %>% 
  group_by(temp_z) %>% 
  mean_qi(.epred)%>% 
  mutate(facet="Temperature (°C)", 
         variable_z_scaled = temp_z*sd(filter(df.final, Species == "Blue Sucker")$MeanTemp)+mean(filter(df.final, Species == "Blue Sucker")$MeanTemp)) %>% 
  rename(variable_z = temp_z)%>% 
  select(-.width, -.point, -.interval); temp_bsr

#join posterior means
df_joined_bsr <- full_join(gage_bsr, temp_bsr) 

#plot
df_joined_bsr %>% ggplot(aes(x=variable_z_scaled, y=.epred))+
  geom_line()+
  geom_ribbon(aes(ymin=.lower, ymax=.upper), alpha=0.2)+
  facet_wrap(~facet, scales="free")+
  scale_x_continuous(n.breaks = 4)+
  ylab("Probability of passage")+
  xlab("")+
  theme_classic()+
  facetted_pos_scales(
    x = list(
      facet == "Gage height (m)" ~ scale_x_continuous(breaks = c(1:4)),
      facet == "Temperature (°C)" ~ scale_x_continuous(breaks = c(5,10,15,20,25))),
    y = list(
      facet == "Gage height (m)" ~ scale_y_continuous(limits = c(0,1)),
      facet == "Temperature (°C)" ~ scale_y_continuous(limits = c(0,1))))+
  theme(axis.text=element_text(size=12), 
        axis.title=element_text(size=16), 
        strip.text=element_text(size=14))

ggsave("Figure5_BSR_TopModel.jpeg", height=5, width=8, units="in")

