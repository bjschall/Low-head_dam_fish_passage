##Data for analysis
load("Low-head_Environ.Rdata")

#
df <- analysis_df %>% 
  mutate(Date = as.Date(format(mdy(Date), "%Y/%m/%d")))

#Summary
df %>% 
  group_by(Species) %>% 
  summarize(n=sum(Attempt), success=sum(Success))

#James River Gage Height Info
siteNo <- "06478513"  
#06478500 is Scotland; 06478000 is Mitchell; 06467500 is Missouri River below Gavins;
#06480000 Brookings; 06481000 Akron; 06482020 Sioux Falls N. Cliff; 06478513 Yankton
pCode <- "00065"
start.date <- "2020-01-01"
end.date <- "2025-12-31"

#######GH Daily Values######
GHdv <- readNWISdv(siteNumbers = siteNo,
                          parameterCd = pCode,
                          startDate = start.date,
                          endDate = end.date)
GHdv<-renameNWISColumns(GHdv) %>% 
  mutate(GH_m = GH*0.3048)


#Combining datasets
df2<-left_join(df, GHdv, by="Date")


#Add one gage height value 
df2 <- df2 %>%
  mutate(GH_m = if_else(ShortID == "28124", 0.694944, GH_m))

#Temperature data
temps %>% filter(Location=="Hwy50_WLL") %>% 
  ggplot(aes(x=as.Date(Date), y=TempF_mod, col=Location)) + geom_line()
  

t2<-temps %>% filter(Location=="Hwy50_WLL") %>% 
  select(Date, TempF_mod) %>% 
  mutate(Date=as.Date(Date), 
         TempC = (TempF_mod-32)*5/9) %>% 
  group_by(Date) %>% 
  summarize(MeanTemp= mean(TempC))

df.3 <- left_join(df2, t2, by="Date") 
  
###Use Missouri River Temperatures to predict James temps for 2021
MO_temps2 <- MO_temps %>% 
  group_by(Date) %>% 
  summarize(MeanTempF = mean(Yankton, na.rm=T))%>% 
  mutate(TmeanC_MO = (MeanTempF-32)*5/9)

#join MO River and James River temperature data into one file
temps3 <- left_join(t2, MO_temps2, by="Date") %>% mutate(Year=year(Date))

#Temperature model
MO_Temp_mod<-brm(MeanTemp ~ TmeanC_MO, 
              data=temps3 %>% filter(Year==2021),
              family = gaussian(),
              file="MO_Temp_model.rds",
              save_pars = save_pars(all = TRUE),
              file_refit = "on_change",
              chains=4, iter=5000, cores=4)


print(MO_Temp_mod, digits=3)
bayes_R2(MO_Temp_mod)
pp_check(MO_Temp_mod)

#identify dates with missing James River temps 
Dates <- df.3 %>% filter(Species=="Blue Sucker"&is.na(MeanTemp)) %>% ungroup() %>% distinct(Date) 
TmeanC_MO <- MO_temps2 %>% 
  mutate(Date=as.Date(Date)) %>% 
  filter(Date %in% Dates$Date)

#Sample posterior for magnitude of difference
posts <- add_epred_draws(MO_Temp_mod, newdata = TmeanC_MO %>% select(TmeanC_MO))
posts2 <- posts %>% group_by(TmeanC_MO) %>% mean_qi(.epred) %>% left_join(TmeanC_MO); posts2

#add mean estimates to final dataframe
df.final <- df.3 %>%
  left_join(posts2 %>% select(Date, .epred), by = "Date") %>%
  mutate(MeanTemp = if_else(is.na(MeanTemp), .epred, MeanTemp)) %>%
  select(-.epred) %>% 
  group_by(Species) %>% 
  mutate(
    gage_z   = as.numeric(scale(GH_m)),
    temp_z   = as.numeric(scale(MeanTemp)),
    length_z = as.numeric(scale(Length))
  )

#########################################################################################
#Modeling 
#########################################################################################
#Determine the necessary priors
get_prior(Success|trials(Attempt)~1, 
          data=df.final,
          family = binomial(link="logit"))

#Priors - weakly informative 
priors <- c(
  prior(normal(0, 2), class = "b"),        
  prior(normal(0, 2), class = "Intercept"),
  prior(exponential(1), class = "sd")      
)

#### Blue Sucker ####
########  null model
null_mod<-brm(Success ~ 1 + (1|Year) + (1|ShortID), 
              data=df.final %>% filter(Species=="Blue Sucker"),
              family = bernoulli(link="logit"),
              prior = c(
                prior(normal(0, 2), class = "Intercept"),
                prior(exponential(1), class = "sd")),
              file="BS.Null_model.rds",
              save_pars = save_pars(all = TRUE),
              file_refit = "on_change",
              chains=4, iter=5000, cores=4)

print(null_mod, digits=4)
plot(null_mod)
pp_check(null_mod, ndraws =30)
bayes_R2(null_mod)

#Gage height model 
gage_mod <- brm(
  Success ~ gage_z + (1 | Year) + (1 | ShortID),
  data = df.final %>% filter(Species == "Blue Sucker"),
  family = bernoulli(),
  prior = priors,
  file = "BS.gage_model.rds",
  save_pars = save_pars(all = TRUE),
  control = list(adapt_delta = 0.99),
  file_refit = "on_change",
  chains = 4, iter = 5000, cores = 4
)

print(gage_mod, digits=3)
plot(gage_mod)
pp_check(gage_mod, ndraws =30)
bayes_R2(gage_mod)

