pCode <- "00065"
start.date <- "2020-01-01"
end.date <- "2026-07-31"

#######GH Daily Values######
GHdv <- readNWISdv(siteNumbers = siteNo,
                          parameterCd = pCode,
                          startDate = start.date,
                          endDate = end.date)
GHdv<-renameNWISColumns(GHdv) %>% 
  mutate(GH_m = GH*0.3048)


#Combining datasets
df2<-left_join(df, GHdv, by="Date")


#Add one gage height value 
df2 <- df2 %>%
  mutate(GH_m = replace_na(GH_m, 0.694944))

#Temperature data
temps %>% filter(Location=="Hwy50_WLL") %>% 
  ggplot(aes(x=as.Date(Date), y=TempF_mod, col=Location)) + geom_line()
  

t2<-temps %>% filter(Location=="Hwy50_WLL") %>% 
  select(Date, TempF_mod) %>% 
  mutate(Date=as.Date(Date), 
         TempC = (TempF_mod-32)*5/9) %>% 
  group_by(Date) %>% 
  summarize(MeanTemp= mean(TempC))

df.3 <- left_join(df2, t2, by="Date") 
  
###Use Missouri River Temperatures to predict James temps for 2021
MO_temps2 <- MO_temps %>% 
  group_by(Date) %>% 
  summarize(MeanTempF = mean(Yankton, na.rm=T))%>% 
  mutate(TmeanC_MO = (MeanTempF-32)*5/9)

#join MO River and James River temperature data into one file
temps3 <- left_join(t2, MO_temps2, by="Date") %>% mutate(Year=year(Date))

#Temperature model
MO_Temp_mod<-brm(MeanTemp ~ TmeanC_MO, 
              data=temps3 %>% filter(Year==2021),
              family = gaussian(),
              file="MO_Temp_model.rds",
              save_pars = save_pars(all = TRUE),
              file_refit = "on_change",
              chains=4, iter=5000, cores=4)


print(MO_Temp_mod, digits=3)
bayes_R2(MO_Temp_mod)
pp_check(MO_Temp_mod)

#identify dates with missing James River temps 
Dates <- df.3 %>% filter(Species=="Blue Sucker"&is.na(MeanTemp)) %>% ungroup() %>% distinct(Date) 
TmeanC_MO <- MO_temps2 %>% 
  mutate(Date=as.Date(Date)) %>% 
  filter(Date %in% Dates$Date)

#Sample posterior for magnitude of difference
posts <- add_epred_draws(MO_Temp_mod, newdata = TmeanC_MO %>% select(TmeanC_MO))
posts2 <- posts %>% group_by(TmeanC_MO) %>% mean_qi(.epred) %>% left_join(TmeanC_MO); posts2

#summarize temps for 2024 missing data day
temps %>% filter(Date=="2024-03-15") %>% group_by(Location) %>% summarize(mean(TempF)) %>% as.data.frame()

#add mean estimates to final dataframe
df.final <- df.3 %>%
  left_join(posts2 %>% select(Date, .epred), by = "Date") %>%
  mutate(MeanTemp = if_else(is.na(MeanTemp), .epred, MeanTemp)) %>%
  select(-.epred) %>% 
  mutate(MeanTemp = replace_na(MeanTemp, 47.6450)) %>% #replace temp data for 2024-03-15 due to malfunction; use mean temp from 303rd receiver
